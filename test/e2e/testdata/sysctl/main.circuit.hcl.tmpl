circuit "kernel" {
  hosts = { box = "127.0.0.1" }

  ssh {
    port             = {{.Port}}
    user             = "root"
    private_key_file = "{{.KeyFile}}"
    known_hosts_file = "{{.KnownHosts}}"
  }

  step "procps" {
    package {
      name = "{{.Package}}"
    }
  }
{{if .WithSysctl}}
  step "ports" {
    sysctl {
      name  = "net.ipv4.ip_local_port_range"
      value = "20000 60999"
    }
  }
{{end}}
}
